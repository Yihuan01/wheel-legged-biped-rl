      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.1 0 0.02"/>
      <geometry>
        <box size="0.2 0.08 0.04"/>
        <!-- <mesh filename="../meshes_v1/left_thigh_link.STL" /> -->
      </geometry>
    </collision>
  </link>

  <link name="left_shank_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.12156 0.0048719 0.01996"/>
      <mass value="0.93138"/>
      <inertia ixx="0.00092062" ixy="-0.00090165" ixz="2.7E-05" iyy="0.0071235" iyz="7.25E-06" izz="0.0078024"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes_v1/left_shank_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <!-- wbr_v2：碰撞体由 STL 网格换成盒体（从动轮球是小腿侧唯一定义触地点，见文件头说明 2） -->
    <collision>
      <origin rpy="0 0 0" xyz="0.085 0.001 0.0145"/>
      <geometry>
        <box size="0.286 0.098 0.057"/>
        <!-- <mesh filename="../meshes_v1/left_shank_link.STL" /> -->
      </geometry>
    </collision>
  </link>

  <link name="right_thigh_link">
    <inertial>
      <origin rpy="3.141590 0 0" xyz="0.15659 0.00019029 0.02025"/>
      <mass value="0.80815"/>
      <inertia ixx="0.00058927" ixy="-6.416E-05" ixz="-6.077E-05" iyy="0.0047671" iyz="-1.5E-06" izz="0.0051529"/>
    </inertial>
    <visual>
      <origin rpy="3.141590 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes_v1/right_thigh_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.1 0 0.02"/>
      <geometry>
        <box size="0.2 0.08 0.04"/>
        <!-- <mesh filename="../meshes_v1/left_thigh_link.STL" /> -->
      </geometry>
      <!-- <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes_v1/right_thigh_link.STL" />
      </geometry> -->
    </collision>
  </link>

  <link name="right_shank_link">
    <inertial>
      <origin rpy="3.141590 0 0" xyz="0.12114 0.0051863 0.020146"/>
      <mass value="0.92691"/>
      <inertia ixx="0.00090882" ixy="-0.00088222" ixz="-3.749E-05" iyy="0.0070874" iyz="-1E-06" izz="0.0077607"/>
    </inertial>
    <visual>
      <origin rpy="3.141590 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes_v1/right_shank_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <!-- wbr_v2：碰撞体由 STL 网格换成盒体（经 rpy=pi 放置后覆盖区与左腿镜像一致，见文件头说明 2） -->
    <collision>
      <origin rpy="3.141590 0 0" xyz="0.085 0.001 0.0145"/>
      <geometry>
        <box size="0.286 0.098 0.057"/>
        <!-- <mesh filename="../meshes_v1/right_shank_link.STL" /> -->
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.025381"/>
      <mass value="0.55336"/>
      <inertia ixx="0.0010902" ixy="0" ixz="0" iyy="0.0010902" iyz="0" izz="0.0019745"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes_v1/left_wheel_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.027"/>
      <geometry>
        <cylinder length="0.048" radius="0.08"/>
        <!-- <mesh
          filename="../meshes_v1/left_wheel_link.STL" /> -->
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <origin rpy="3.141590 0 0" xyz="0 0 0.025381"/>
      <mass value="0.55336"/>
      <inertia ixx="0.0010902" ixy="0" ixz="0" iyy="0.0010902" iyz="0" izz="0.0019745"/>
    </inertial>
    <visual>
      <origin rpy="3.141590 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes_v1/right_wheel_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.027"/>
      <geometry>
        <cylinder length="0.048" radius="0.08"/>
        <!-- <mesh
          filename="../meshes_v1/right_thigh_link.STL" /> -->
      </geometry>
    </collision>
  </link>

  <!-- wbr_v2 新增：左膝关节从动轮（球形单轴被动轮，参数实测见文件头说明 3） -->
  <link name="left_knee_caster">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.682e-05" ixy="0" ixz="0" iyy="1.682e-05" iyz="0" izz="1.682e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.029"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.029"/>
      </geometry>
    </collision>
  </link>

  <!-- wbr_v2 新增：右膝关节从动轮（与左侧镜像：小腿 link 系球心 y 取负，见文件头说明 3） -->
  <link name="right_knee_caster">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.682e-05" ixy="0" ixz="0" iyy="1.682e-05" iyz="0" izz="1.682e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.029"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.029"/>
      </geometry>
    </collision>
  </link>

  <!-- 调用机器人连杆 -->
  <joint name="left_hip_joint" type="revolute">
    <origin rpy="-1.570796327 1.570796327 0" xyz="0 0.0936 0"/>
    <parent link="base_link"/>
    <child link="left_thigh_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="-1.5708" upper="1.5708" velocity="30.0"/>
  </joint>
  <joint name="left_knee_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.2 0 0.0403"/>
    <parent link="left_thigh_link"/>
    <child link="left_shank_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="-2.7053" upper="-0.1" velocity="30.0"/>
  </joint>
  <joint name="left_wheel_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.18 0 0.0403"/>
    <parent link="left_shank_link"/>
    <child link="left_wheel_link"/>
    <limit effort="23.7" velocity="30.0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="right_hip_joint" type="revolute">
    <origin rpy="1.570796327 1.570796327 0" xyz="0 -0.0936 0"/>
    <parent link="base_link"/>
    <child link="right_thigh_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="-1.5708" upper="1.5708" velocity="30.0"/>
  </joint>
  <joint name="right_knee_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.2 0 0.0403"/>
    <parent link="right_thigh_link"/>
    <child link="right_shank_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="0.1" upper="2.7053" velocity="30.0"/>
  </joint>
  <joint name="right_wheel_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.18 0 0.0403"/>
    <parent link="right_shank_link"/>
    <child link="right_wheel_link"/>
    <limit effort="23.7" velocity="30.0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- wbr_v2 新增关节：追加在末尾，dof 0~5 与 wbr_v1 完全一致（见文件头说明 4） -->
  <joint name="left_knee_caster_joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.02939 0.05000 0.01983"/>
    <parent link="left_shank_link"/>
    <child link="left_knee_caster"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <joint name="right_knee_caster_joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.02939 -0.05000 0.01983"/>
    <parent link="right_shank_link"/>
    <child link="right_knee_caster"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!--
  wbr_v2 备选变体（注释保留，默认不启用）：三轴万向架牛眼轮（左腿示例，右侧镜像同理）
  启用方法：删去本注释与上面的 left_knee_caster_joint，改用下方三关节链。
  <joint name="left_caster_gz" type="continuous">
    <origin rpy="0 0 0" xyz="-0.02939 0.05000 0.01983"/>
    <parent link="left_shank_link"/>
    <child link="left_caster_gimbal_z"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <link name="left_caster_gimbal_z">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
    </inertial>
  </link>
  <joint name="left_caster_gx" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="left_caster_gimbal_z"/>
    <child link="left_caster_gimbal_x"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <link name="left_caster_gimbal_x">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
    </inertial>
  </link>
  <joint name="left_caster_gy" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="left_caster_gimbal_x"/>
    <child link="left_knee_caster_ball"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <link name="left_knee_caster_ball">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.682e-05" ixy="0" ixz="0" iyy="1.682e-05" iyz="0" izz="1.682e-05"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.029"/></geometry>
    </collision>
  </link>
  -->

  <!-- wbr_v2：免除膝关节从动球与同侧大腿的碰撞干涉（见文件头说明 7）。
       球心在膝端、球半径 29mm，膝接近伸直时球会擦到大腿；球在 shank 下、大腿是 shank 的父级
       （隔代关系，不会被父子自动过滤），碰撞体层面约 5mm 重叠，显式排除以避免误判接触。 -->
  <contact>
    <exclude link1="left_thigh_link" link2="left_knee_caster"/>
    <exclude link1="right_thigh_link" link2="right_knee_caster"/>
  </contact>
</robot>
