<?xml version="1.0" ?>
<!-- 
轮腿机器人URDF描述 (wbr_v1.urdf)
*** SYH *** 2026.03.27 ***

来自ZZW的轮腿机器人ros包的xacro文件，经过修改以适应Wheel-Legged-Gym仿真环境。

此URDF文件描述了一个轮腿机器人（WBR - 轮腿机器人）版本1。
机器人具有一个基座主体和两条对称的腿，每条腿由以下部分组成：
- 大腿连杆（上腿段）
- 小腿连杆（下腿段） 
- 轮子连杆（每条腿末端的驱动轮）

关键组件：
- base_link：具有惯性属性和简化碰撞盒的主主体
- left/right_thigh_link：具有旋转髋关节的上腿段
- left/right_shank_link：具有旋转膝关节的下腿段
- left/right_wheel_link：具有连续旋转关节的轮子组件

特性：
- 对称的左右腿配置
- 使用STL网格文件进行视觉渲染
- 简化的碰撞几何体（盒子/圆柱体）以提高仿真性能
- 定义关节限制和动力学参数以实现真实行为

此模型设计用于Wheel-Legged-Gym仿真环境中进行强化学习和控制算法开发。
-->

<robot name="wbr_v1">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="4.4472E-05 0.0001156 0.010416"/>
      <mass value="2.5418"/>
      <inertia ixx="0.015752" ixy="-0.00040242" ixz="9.948E-05" iyy="0.010651" iyz="-0.00036894" izz="0.013679"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes_v1/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <!-- 替换以下原来的mesh，看看能不能提升仿真的速度 -->
        <!-- <mesh filename="../meshes_v1/base_link.STL" /> -->
        <box size="0.18 0.16 0.10"/>
      </geometry>
    </collision>
  </link>

  <link name="left_thigh_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.15659 0.00032005 0.02025"/>
      <mass value="0.80815"/>
      <inertia ixx="0.00058921" ixy="-6.148E-05" ixz="6.077E-05" iyy="0.0047671" iyz="1.4E-07" izz="0.0051528"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes_v1/left_thigh_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.1 0 0.02"/>
      <geometry>
        <box size="0.2 0.08 0.04"/>
        <!-- <mesh filename="../meshes_v1/left_thigh_link.STL" /> -->
      </geometry>
    </collision>
  </link>

  <link name="left_shank_link">
