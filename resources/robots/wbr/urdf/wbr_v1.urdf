  <!-- 调用机器人连杆 -->
  <joint name="left_hip_joint" type="revolute">
    <origin rpy="-1.570796327 1.570796327 0" xyz="0 0.0936 0"/>
    <parent link="base_link"/>
    <child link="left_thigh_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="-1.5708" upper="1.5708" velocity="30.0"/>
  </joint>
  <joint name="left_knee_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.2 0 0.0403"/>
    <parent link="left_thigh_link"/>
    <child link="left_shank_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="-2.7053" upper="-0.1" velocity="30.0"/>
  </joint>
  <joint name="left_wheel_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.18 0 0.0403"/>
    <parent link="left_shank_link"/>
    <child link="left_wheel_link"/>
    <limit effort="23.7" velocity="30.0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="right_hip_joint" type="revolute">
    <origin rpy="1.570796327 1.570796327 0" xyz="0 -0.0936 0"/>
    <parent link="base_link"/>
    <child link="right_thigh_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="-1.5708" upper="1.5708" velocity="30.0"/>
  </joint>
  <joint name="right_knee_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.2 0 0.0403"/>
    <parent link="right_thigh_link"/>
    <child link="right_shank_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="23.7" lower="0.1" upper="2.7053" velocity="30.0"/>
  </joint>
  <joint name="right_wheel_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.18 0 0.0403"/>
    <parent link="right_shank_link"/>
    <child link="right_wheel_link"/>
    <limit effort="23.7" velocity="30.0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
